{
  "_about": "What setup_server.py builds. Phase 'hidden' creates everything only you can see; phase 'reveal' shows it and switches on the server-wide settings. Re-running is safe: what it made is remembered in server_state.json.",
  "server": {
    "name": "24/7 Shiny Hunting",
    "default_notifications": "only_mentions",
    "verification_level": 2,
    "explicit_content_filter": 2,
    "community": true,
    "rules_channel": "rules",
    "updates_channel": "mod-log",
    "safety_channel": "mod-log",
    "system_channel": "mod-log",
    "system_channel_flags": 12
  },
  "bot": {
    "name": "autocrystal",
    "avatar": "art/avatar.png"
  },
  "roles": [
    {
      "name": "Admin",
      "color": "#E74C3C",
      "hoist": true,
      "perms": [
        "ADMINISTRATOR"
      ]
    },
    {
      "name": "Moderator",
      "color": "#3498DB",
      "hoist": true,
      "perms": [
        "member",
        "KICK_MEMBERS",
        "BAN_MEMBERS",
        "MODERATE_MEMBERS",
        "MANAGE_MESSAGES",
        "MANAGE_THREADS",
        "MANAGE_NICKNAMES",
        "VIEW_AUDIT_LOG",
        "MUTE_MEMBERS",
        "MOVE_MEMBERS",
        "MENTION_EVERYONE"
      ]
    },
    {
      "name": "Trainer",
      "color": "#2ECC71",
      "hoist": false,
      "perms": [
        "member"
      ]
    },
    {
      "name": "Shiny Ping",
      "color": "#F1C40F",
      "hoist": false,
      "perms": []
    },
    {
      "name": "DV Ping",
      "color": "#9B59B6",
      "hoist": false,
      "perms": []
    },
    {
      "name": "Release Ping",
      "color": "#1ABC9C",
      "hoist": false,
      "perms": []
    }
  ],
  "categories": [
