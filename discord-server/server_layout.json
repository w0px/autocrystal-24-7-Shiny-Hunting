        },
        {
          "name": "stream-links",
          "kind": "text",
          "access": "readonly",
          "topic": "Where to watch",
          "staff_post": true
        },
        {
          "name": "faq",
          "kind": "text",
          "access": "readonly",
          "topic": "Questions people ask a lot",
          "staff_post": true,
          "post": "faq"
        }
      ]
    },
    {
      "name": "LIVE HUNTING NOTIFICATIONS",
      "channels": [
        {
          "name": "shinies",
          "kind": "text",
          "access": "readonly",
          "topic": "Every shiny, perfect DV and 0/0/0/0 the stream finds, posted live by the bot",
          "webhook": true,
          "pings": true
        },
        {
          "name": "daily-log",
          "kind": "text",
          "access": "readonly",
          "topic": "The bot's 24h report",
          "webhook": true
        },
        {
          "name": "shiny-clips",
          "kind": "text",
          "access": "readonly",
          "topic": "Clips of the shinies",
          "staff_post": true
        }
      ]
    },
    {
      "name": "AUTOCRYSTAL USER BOT",
      "channels": [
        {
          "name": "releases",
